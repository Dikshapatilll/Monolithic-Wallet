# Monolith Wallet System - Environment Configuration Example
# Copy this file to .env or export these variables in your deployment environment.
# Never commit real credentials or production secrets to source control.

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/wallet?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Security Configuration
# Secret key MUST be at least 256 bits (32 characters) for HMAC-SHA256
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_at_least_32_chars_long
JWT_EXPIRATION_MS=86400000

# Server Configuration
PORT=8080
